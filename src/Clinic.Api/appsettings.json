{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=clinic_saas;Username=clinic;Password=clinic_password",
    "Redis": "localhost:6379"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Jwt": {
    "Issuer": "ClinicManagementSaaS",
    "Audience": "ClinicManagementSaaS.Client",
    "SigningKey": "replace-this-development-signing-key-with-a-secure-secret-32-bytes-minimum",
    "ExpirationMinutes": 60
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin123",
    "BucketName": "patient-documents",
    "UseSsl": false
  },
  "Sentry": {
    "Dsn": "",
    "SendDefaultPii": false,
    "TracesSampleRate": 0.2
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}
